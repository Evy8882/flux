# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3333

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Formato local:  mongodb://localhost:27017/flux
# Formato Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flux
MONGODB_URI=mongodb://localhost:27017/flux

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Troque por uma string longa e aleatória em produção
JWT_SECRET=flux_dev_secret_key
